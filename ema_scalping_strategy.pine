//@version=6
strategy(
     title                   = "EMA Scalping Strategy 7/17 [Optimized]",
     shorttitle              = "EMA Scalp 7/17 Pro",
     overlay                 = true,
     process_orders_on_close  = true,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 1,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.05,
     slippage                = 1
 )

// ═══════════════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════════════
grpEma = "EMA Settings"
emaFastLen = input.int(7,  "Fast EMA", minval=1, group=grpEma)
emaSlowLen = input.int(17, "Slow EMA", minval=1, group=grpEma)

grpMom = "Momentum / ADX Filter"
adxLen      = input.int(14,   "ADX Length",              minval=1,  group=grpMom)
adxThresh   = input.float(20, "Min ADX (Trend Strength)", minval=0, step=1, group=grpMom,
              tooltip="ADX ≥ 20 = trending market. Below 20 = choppy — no trades taken.")
slopeThresh = input.float(0.0001, "Min EMA7 Slope (fraction of price)",
              minval=0.0, step=0.00005, group=grpMom)

grpCross = "Crossover Recency"
crossRecency = input.int(8, "Max bars since EMA cross", minval=1, maxval=50, group=grpCross,
               tooltip="Only enter if EMA7 crossed EMA17 within the last N bars. Prevents late entries at trend exhaustion.")

grpRsi = "RSI Filter"
rsiLen = input.int(14,   "RSI Length",                         minval=1,  group=grpRsi)
rsiOB  = input.float(65, "Overbought ceiling (no Longs above)", minval=50, maxval=90, step=1, group=grpRsi)
rsiOS  = input.float(35, "Oversold floor (no Shorts below)",    minval=10, maxval=50, step=1, group=grpRsi)

grpPat = "Candlestick Patterns"
pinBarWickRatio = input.float(0.55, "Pin Bar – Min Wick/Range",     minval=0.1, maxval=0.95, step=0.05, group=grpPat)
bigCandleRatio  = input.float(0.60, "Big Candle – Min Body/Range",  minval=0.1, maxval=0.99, step=0.05, group=grpPat)
engulfRatio     = input.float(1.00, "Engulfing – Body vs Prev (×)", minval=0.5, step=0.05, group=grpPat)

grpRisk = "Risk Management"
atrLen    = input.int(14,   "ATR Length",          minval=1,  group=grpRisk)
atrSlMult = input.float(1.5, "SL = ATR ×",         minval=0.1, step=0.1, group=grpRisk,
            tooltip="Stop-Loss = entry ± (ATR × multiplier). ATR-based SL adapts to volatility — less premature stops than candle-based SL.")
rrRatio   = input.float(2.0, "Risk:Reward Ratio",  minval=0.5, step=0.5, group=grpRisk,
            tooltip="1:2 is more realistic for scalping than 1:3, resulting in a higher win rate.")
useTrail  = input.bool(false, "Use Trailing Stop",              group=grpRisk,
            tooltip="Trails the stop behind price by ATR × multiplier to lock in profits.")
trailMult = input.float(1.0, "Trail Stop = ATR ×", minval=0.1, step=0.1, group=grpRisk)

grpHTF = "Higher Timeframe Filter"
htfRes = input.timeframe("60", "HTF (trend confirmation)", group=grpHTF,
         tooltip="Only trade in the direction of the trend on this timeframe.")

grpSession = "Session Filter"
useSession = input.bool(false, "Limit to Active Sessions", group=grpSession,
             tooltip="Avoids low-liquidity periods with more false signals.")
sessionStr = input.string("0700-1600", "Session Window (UTC)",  group=grpSession,
             tooltip="Default 07:00–16:00 UTC covers London open + NY overlap.")

grpVis = "Visuals"
showBoxes    = input.bool(true,  "Show SL / TP Boxes",      group=grpVis)
showBg       = input.bool(true,  "Show Momentum Background", group=grpVis)
showHTFCloud = input.bool(true,  "Show HTF EMA Cloud",       group=grpVis)

// ═══════════════════════════════════════════════════════════════════
//  EMA + SLOPE
// ═══════════════════════════════════════════════════════════════════
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

bullTrend    = emaFast > emaSlow
bearTrend    = emaFast < emaSlow

emaFastSlope = (emaFast - emaFast[1]) / close
bullMomentum = bullTrend and emaFastSlope >  slopeThresh
bearMomentum = bearTrend and emaFastSlope < -slopeThresh
hasMomentum  = bullMomentum or bearMomentum

// ═══════════════════════════════════════════════════════════════════
//  CROSSOVER RECENCY  — avoid entering a trend that's already old
// ═══════════════════════════════════════════════════════════════════
bullCross = ta.crossover(emaFast,  emaSlow)
bearCross = ta.crossunder(emaFast, emaSlow)

var int barsSinceBull = 999
var int barsSinceBear = 999
barsSinceBull := bullCross ? 0 : barsSinceBull + 1
barsSinceBear := bearCross ? 0 : barsSinceBear + 1

recentBullCross = barsSinceBull <= crossRecency
recentBearCross = barsSinceBear <= crossRecency

// ═══════════════════════════════════════════════════════════════════
//  ADX — trend strength (filters choppy / sideways markets)
// ═══════════════════════════════════════════════════════════════════
[_diPlus, _diMinus, adxVal] = ta.dmi(adxLen, adxLen)
trendStrong = adxVal >= adxThresh

// ═══════════════════════════════════════════════════════════════════
//  RSI — avoid overbought longs and oversold shorts
// ═══════════════════════════════════════════════════════════════════
rsiVal    = ta.rsi(close, rsiLen)
rsiBullOk = rsiVal < rsiOB
rsiBearOk = rsiVal > rsiOS

// ═══════════════════════════════════════════════════════════════════
//  ATR — adaptive stop-loss sizing
// ═══════════════════════════════════════════════════════════════════
atr14 = ta.atr(atrLen)

// ═══════════════════════════════════════════════════════════════════
//  HIGHER TIMEFRAME FILTER
// ═══════════════════════════════════════════════════════════════════
htfEmaFast = request.security(syminfo.tickerid, htfRes,
              ta.ema(close, emaFastLen), lookahead=barmerge.lookahead_off)
htfEmaSlow = request.security(syminfo.tickerid, htfRes,
              ta.ema(close, emaSlowLen), lookahead=barmerge.lookahead_off)
htfBull = htfEmaFast > htfEmaSlow
htfBear = htfEmaFast < htfEmaSlow

// ═══════════════════════════════════════════════════════════════════
//  SESSION FILTER
// ═══════════════════════════════════════════════════════════════════
inSession = useSession ? not na(time(timeframe.period, sessionStr, "UTC")) : true

// ═══════════════════════════════════════════════════════════════════
//  CANDLESTICK PATTERNS
// ═══════════════════════════════════════════════════════════════════
candleBody  = math.abs(close - open)
candleRange = high - low
upperWick   = high - math.max(close, open)
lowerWick   = math.min(close, open) - low
prevBody    = math.abs(close[1] - open[1])
bullCandle  = close > open
bearCandle  = close < open
validRange  = candleRange > 0
validBody   = prevBody    > 0

// 1. Pin Bar
bullPinBar = validRange
             and lowerWick >= pinBarWickRatio * candleRange
             and upperWick  < (1.0 - pinBarWickRatio) * candleRange
bearPinBar = validRange
             and upperWick  >= pinBarWickRatio * candleRange
             and lowerWick   < (1.0 - pinBarWickRatio) * candleRange

// 2. Big Momentum Candle
bullBigCandle = validRange and bullCandle and (candleBody / candleRange) >= bigCandleRatio
bearBigCandle = validRange and bearCandle and (candleBody / candleRange) >= bigCandleRatio

// 3. Engulfing
bullEngulf = validBody and bullCandle and not bullCandle[1]
             and (candleBody / prevBody) >= engulfRatio
             and close >= open[1] and open <= close[1]
bearEngulf = validBody and bearCandle and not bearCandle[1]
             and (candleBody / prevBody) >= engulfRatio
             and close <= open[1] and open >= close[1]

bullPattern = bullPinBar or bullBigCandle or bullEngulf
bearPattern = bearPinBar or bearBigCandle or bearEngulf

// ═══════════════════════════════════════════════════════════════════
//  ENTRY CONDITIONS  — all 6 filters must pass
// ═══════════════════════════════════════════════════════════════════
noPosition     = strategy.position_size == 0
longCondition  = bullMomentum and recentBullCross and trendStrong
                 and htfBull and rsiBullOk and bullPattern and inSession and noPosition
shortCondition = bearMomentum and recentBearCross and trendStrong
                 and htfBear and rsiBearOk and bearPattern and inSession and noPosition

// ═══════════════════════════════════════════════════════════════════
//  TRADE STATE  (persists across bars)
// ═══════════════════════════════════════════════════════════════════
var float activeSL  = na
var float activeTP  = na
var box   slBox     = na
var box   tpBox     = na
var line  entryLine = na

// ═══════════════════════════════════════════════════════════════════
//  TRAILING STOP UPDATE  (runs every bar while in position)
//  Calls strategy.exit each bar to move the stop — overrides the
//  initial exit placed at entry, which is correct behaviour.
// ═══════════════════════════════════════════════════════════════════
if strategy.position_size > 0
    if useTrail
        newTS    = close - trailMult * atr14
        activeSL := math.max(nz(activeSL, newTS), newTS)
    strategy.exit("Long Exit", "Long", stop=activeSL, limit=activeTP)

if strategy.position_size < 0
    if useTrail
        newTS    = close + trailMult * atr14
        activeSL := math.min(nz(activeSL, newTS), newTS)
    strategy.exit("Short Exit", "Short", stop=activeSL, limit=activeTP)

// ─── Cleanup when position is closed ────────────────────────────────────────
positionClosed = strategy.position_size == 0 and strategy.position_size[1] != 0
if positionClosed
    activeSL := na
    activeTP := na
    box.delete(slBox)
    box.delete(tpBox)
    line.delete(entryLine)

// ═══════════════════════════════════════════════════════════════════
//  ENTRIES  + BOX DRAW
// ═══════════════════════════════════════════════════════════════════
if longCondition
    slDist   = atr14 * atrSlMult
    activeSL := close - slDist
    activeTP := close + slDist * rrRatio
    if showBoxes
        box.delete(slBox)
        box.delete(tpBox)
        line.delete(entryLine)
        slBox     := box.new(bar_index, close, bar_index + 1, activeSL,
                             extend=extend.right,
                             border_color=color.new(color.red,   20), border_width=1,
                             bgcolor     =color.new(color.red,   82))
        tpBox     := box.new(bar_index, close, bar_index + 1, activeTP,
                             extend=extend.right,
                             border_color=color.new(color.green, 20), border_width=1,
                             bgcolor     =color.new(color.green, 82))
        entryLine := line.new(bar_index, close, bar_index + 1, close,
                              extend=extend.right,
                              color =color.new(color.white, 30), width=1,
                              style =line.style_dashed)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=activeSL, limit=activeTP)

if shortCondition
    slDist   = atr14 * atrSlMult
    activeSL := close + slDist
    activeTP := close - slDist * rrRatio
    if showBoxes
        box.delete(slBox)
        box.delete(tpBox)
        line.delete(entryLine)
        slBox     := box.new(bar_index, close, bar_index + 1, activeSL,
                             extend=extend.right,
                             border_color=color.new(color.red,   20), border_width=1,
                             bgcolor     =color.new(color.red,   82))
        tpBox     := box.new(bar_index, close, bar_index + 1, activeTP,
                             extend=extend.right,
                             border_color=color.new(color.green, 20), border_width=1,
                             bgcolor     =color.new(color.green, 82))
        entryLine := line.new(bar_index, close, bar_index + 1, close,
                              extend=extend.right,
                              color =color.new(color.white, 30), width=1,
                              style =line.style_dashed)
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=activeSL, limit=activeTP)

// ═══════════════════════════════════════════════════════════════════
//  VISUALS
// ═══════════════════════════════════════════════════════════════════

// EMA lines
plot(emaFast, "EMA 7",  color=color.new(color.aqua,   0), linewidth=2)
plot(emaSlow, "EMA 17", color=color.new(color.orange, 0), linewidth=2)

// HTF cloud
p1 = plot(showHTFCloud ? htfEmaFast : na, "HTF EMA 7",
          color=color.new(color.blue, 55), linewidth=1)
p2 = plot(showHTFCloud ? htfEmaSlow : na, "HTF EMA 17",
          color=color.new(color.red,  55), linewidth=1)
fill(p1, p2,
     color = htfBull ? color.new(color.green, 88) : color.new(color.red, 88),
     title = "HTF Cloud")

// Momentum background
bgcolor(showBg and hasMomentum
        ? (bullMomentum ? color.new(color.green, 93) : color.new(color.red, 93))
        : na,
        title="Momentum BG")

// Signal arrows
plotshape(longCondition,  "Long",  shape.triangleup,
          location.belowbar, color=color.new(color.lime, 0), size=size.normal)
plotshape(shortCondition, "Short", shape.triangledown,
          location.abovebar, color=color.new(color.red,  0), size=size.normal)

// Pattern labels  (function only creates objects, does not modify global vars — CE10088 safe)
patternLabel(cond, txt, yLoc, col) =>
    if cond
        label.new(bar_index, yLoc, txt,
                  style=label.style_label_center,
                  color=color.new(col, 65),
                  textcolor=color.white,
                  size=size.tiny)

patternLabel(longCondition  and bullPinBar,    "PIN", low  - candleRange * 0.6, color.green)
patternLabel(longCondition  and bullBigCandle, "MOM", low  - candleRange * 0.6, color.teal)
patternLabel(longCondition  and bullEngulf,    "ENG", low  - candleRange * 0.6, color.blue)
patternLabel(shortCondition and bearPinBar,    "PIN", high + candleRange * 0.6, color.red)
patternLabel(shortCondition and bearBigCandle, "MOM", high + candleRange * 0.6, color.maroon)
patternLabel(shortCondition and bearEngulf,    "ENG", high + candleRange * 0.6, color.purple)

// ═══════════════════════════════════════════════════════════════════
//  ALERTS
//  alert()          → feuert automatisch wenn Bedingung eintritt
//  alertcondition() → erscheint im TradingView "Alert erstellen"-Dialog
// ═══════════════════════════════════════════════════════════════════

// Muster-Text für die Alert-Nachricht
patternTxt(isPinBar, isBigCandle, isEngulf) =>
    isPinBar ? "Pin Bar" : isBigCandle ? "Momentum Candle" : isEngulf ? "Engulfing" : "Signal"

longPatternTxt  = patternTxt(bullPinBar,  bullBigCandle,  bullEngulf)
shortPatternTxt = patternTxt(bearPinBar,  bearBigCandle,  bearEngulf)

// Automatische Alerts — feuern beim Bar-Close sobald Signal aktiv
// (alert.freq_once_per_bar_close passt zu process_orders_on_close=true)
if longCondition
    alert("LONG Signal ▲  |  " + syminfo.ticker + " " + timeframe.period + "m" +
          "  |  Muster: " + longPatternTxt +
          "  |  ADX: " + str.tostring(math.round(adxVal, 1)) +
          "  |  RSI: " + str.tostring(math.round(rsiVal, 1)) +
          "  |  SL: " + str.tostring(math.round(close - atr14 * atrSlMult, 5)) +
          "  |  TP: " + str.tostring(math.round(close + atr14 * atrSlMult * rrRatio, 5)),
          alert.freq_once_per_bar_close)

if shortCondition
    alert("SHORT Signal ▼  |  " + syminfo.ticker + " " + timeframe.period + "m" +
          "  |  Muster: " + shortPatternTxt +
          "  |  ADX: " + str.tostring(math.round(adxVal, 1)) +
          "  |  RSI: " + str.tostring(math.round(rsiVal, 1)) +
          "  |  SL: " + str.tostring(math.round(close + atr14 * atrSlMult, 5)) +
          "  |  TP: " + str.tostring(math.round(close - atr14 * atrSlMult * rrRatio, 5)),
          alert.freq_once_per_bar_close)

// Benannte Alert-Bedingungen — erscheinen im "Alert erstellen"-Dialog
// unter: Bedingung → Strategie auswählen → Condition auswählen
alertcondition(longCondition,  "Long Signal  ▲", "LONG Signal — EMA Scalp 7/17")
alertcondition(shortCondition, "Short Signal ▼", "SHORT Signal — EMA Scalp 7/17")
alertcondition(longCondition or shortCondition, "Beliebiges Signal", "Signal — EMA Scalp 7/17")

// ═══════════════════════════════════════════════════════════════════
//  INFO TABLE  — updated every bar (barstate.islast unreliable in
//  strategies with process_orders_on_close = true)
// ═══════════════════════════════════════════════════════════════════
var table infoTable = table.new(position.top_right, 2, 10,
     bgcolor=color.new(color.black, 20), border_color=color.new(color.gray, 30), border_width=1)

trendTxt  = bullTrend    ? "▲ BULL"    : "▼ BEAR"
trendCol  = bullTrend    ? color.lime   : color.red
htfTxt    = htfBull      ? "▲ BULL"    : "▼ BEAR"
htfCol    = htfBull      ? color.lime   : color.red
momTxt    = hasMomentum  ? "✔ ACTIVE"  : "✘ FLAT"
momCol    = hasMomentum  ? color.lime   : color.gray
adxRound  = math.round(adxVal, 1)
adxTxt    = trendStrong  ? "✔ " + str.tostring(adxRound) : "✘ " + str.tostring(adxRound)
adxCol    = trendStrong  ? color.lime   : color.orange
rsiRound  = math.round(rsiVal, 1)
rsiTxt    = str.tostring(rsiRound)
rsiCol    = (rsiVal > rsiOB or rsiVal < rsiOS) ? color.red : color.lime
crossBars = bullTrend ? barsSinceBull : barsSinceBear
crossTxt  = crossBars <= crossRecency
             ? "✔ " + str.tostring(crossBars) + " bars ago"
             : "✘ " + str.tostring(crossBars) + " bars ago"
crossCol  = crossBars <= crossRecency ? color.lime : color.orange
sessTxt   = inSession    ? "✔ OPEN"    : "✘ CLOSED"
sessCol   = inSession    ? color.lime   : color.gray
aligned   = bullTrend == htfBull
algnTxt   = aligned      ? "✔ ALIGNED" : "✘ DIVERGING"
algnCol   = aligned      ? color.lime   : color.orange

table.cell(infoTable, 0, 0, "EMA Scalp 7/17 Pro",
           text_color=color.white, bgcolor=color.new(color.navy, 10), text_size=size.small)
table.cell(infoTable, 1, 0, "",
           text_color=color.white, bgcolor=color.new(color.navy, 10))

table.cell(infoTable, 0, 1, "LTF Trend",  text_color=color.silver, text_size=size.tiny)
table.cell(infoTable, 1, 1, trendTxt,     text_color=trendCol,     text_size=size.tiny)
table.cell(infoTable, 0, 2, "HTF Trend",  text_color=color.silver, text_size=size.tiny)
table.cell(infoTable, 1, 2, htfTxt,       text_color=htfCol,       text_size=size.tiny)
table.cell(infoTable, 0, 3, "Alignment",  text_color=color.silver, text_size=size.tiny)
table.cell(infoTable, 1, 3, algnTxt,      text_color=algnCol,      text_size=size.tiny)
table.cell(infoTable, 0, 4, "Momentum",   text_color=color.silver, text_size=size.tiny)
table.cell(infoTable, 1, 4, momTxt,       text_color=momCol,       text_size=size.tiny)
table.cell(infoTable, 0, 5, "ADX",        text_color=color.silver, text_size=size.tiny)
table.cell(infoTable, 1, 5, adxTxt,       text_color=adxCol,       text_size=size.tiny)
table.cell(infoTable, 0, 6, "RSI",        text_color=color.silver, text_size=size.tiny)
table.cell(infoTable, 1, 6, rsiTxt,       text_color=rsiCol,       text_size=size.tiny)
table.cell(infoTable, 0, 7, "EMA Cross",  text_color=color.silver, text_size=size.tiny)
table.cell(infoTable, 1, 7, crossTxt,     text_color=crossCol,     text_size=size.tiny)
table.cell(infoTable, 0, 8, "Session",    text_color=color.silver, text_size=size.tiny)
table.cell(infoTable, 1, 8, sessTxt,      text_color=sessCol,      text_size=size.tiny)
table.cell(infoTable, 0, 9, "RR Ratio",   text_color=color.silver, text_size=size.tiny)
table.cell(infoTable, 1, 9, "1:" + str.tostring(rrRatio),
           text_color=color.yellow, text_size=size.tiny)
