//@version=6
strategy(
     title                  = "EMA Scalping Strategy 7/17 [Trader DNA]",
     shorttitle             = "EMA Scalp 7/17",
     overlay                = true,
     process_orders_on_close = true,   // execute at signal-bar close, not next open
     default_qty_type       = strategy.percent_of_equity,
     default_qty_value      = 1,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.05,
     slippage               = 1
 )

// ═══════════════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════════════
grpEma = "EMA Settings"
emaFastLen = input.int(7,  "Fast EMA", minval=1, group=grpEma)
emaSlowLen = input.int(17, "Slow EMA", minval=1, group=grpEma)

grpMom = "Momentum Filter"
slopeThresh = input.float(0.0001, "Min Slope Threshold (fraction of price)",
              minval=0.0, step=0.00005, group=grpMom,
              tooltip="EMA7 change per bar ÷ price. Lower = more signals, Higher = stricter.")

grpPat = "Candlestick Patterns"
pinBarWickRatio = input.float(0.55, "Pin Bar – Min Wick/Range",
                 minval=0.1, maxval=0.95, step=0.05, group=grpPat)
bigCandleRatio  = input.float(0.60, "Big Candle – Min Body/Range",
                 minval=0.1, maxval=0.99, step=0.05, group=grpPat)
engulfRatio     = input.float(1.00, "Engulfing – Body vs Prev Body (×)",
                 minval=0.5, step=0.05, group=grpPat)

grpRisk = "Risk Management"
rrRatio  = input.float(3.0, "Risk:Reward Ratio", minval=0.5, step=0.5, group=grpRisk)
slBuffer = input.float(5.0, "SL Buffer (% of SL distance)", minval=0.0, step=1.0, group=grpRisk,
           tooltip="Adds extra room to the stop-loss so minor wicks don't stop you out.")

grpHTF = "Higher Timeframe Filter"
htfRes = input.timeframe("60", "HTF (trend confirmation)", group=grpHTF,
         tooltip="Only trade when current TF and this TF agree on direction.")

grpVis = "Visuals"
showBoxes    = input.bool(true,  "Show SL / TP Boxes",       group=grpVis)
showBg       = input.bool(true,  "Show Momentum Background",  group=grpVis)
showHTFCloud = input.bool(true,  "Show HTF EMA Cloud",        group=grpVis)

// ═══════════════════════════════════════════════════════════════════
//  EMA + MOMENTUM
// ═══════════════════════════════════════════════════════════════════
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// Slope over 1 bar (most responsive) — normalized to price level
emaFastSlope = (emaFast - emaFast[1]) / close

bullTrend    = emaFast > emaSlow
bearTrend    = emaFast < emaSlow
bullMomentum = bullTrend and emaFastSlope >  slopeThresh
bearMomentum = bearTrend and emaFastSlope < -slopeThresh
hasMomentum  = bullMomentum or bearMomentum

// ═══════════════════════════════════════════════════════════════════
//  HIGHER TIMEFRAME FILTER
// ═══════════════════════════════════════════════════════════════════
htfEmaFast = request.security(syminfo.tickerid, htfRes, ta.ema(close, emaFastLen),
              lookahead=barmerge.lookahead_off)
htfEmaSlow = request.security(syminfo.tickerid, htfRes, ta.ema(close, emaSlowLen),
              lookahead=barmerge.lookahead_off)
htfBull = htfEmaFast > htfEmaSlow
htfBear = htfEmaFast < htfEmaSlow

// ═══════════════════════════════════════════════════════════════════
//  CANDLESTICK PATTERNS
// ═══════════════════════════════════════════════════════════════════
candleBody  = math.abs(close - open)
candleRange = high - low
upperWick   = high - math.max(close, open)
lowerWick   = math.min(close, open) - low
prevBody    = math.abs(close[1] - open[1])
bullCandle  = close > open
bearCandle  = close < open
validRange  = candleRange > 0
validBody   = prevBody    > 0

// 1. Pin Bar
bullPinBar = validRange
             and lowerWick >= pinBarWickRatio * candleRange
             and upperWick  < (1.0 - pinBarWickRatio) * candleRange

bearPinBar = validRange
             and upperWick  >= pinBarWickRatio * candleRange
             and lowerWick   < (1.0 - pinBarWickRatio) * candleRange

// 2. Big Momentum Candle
bullBigCandle = validRange and bullCandle and (candleBody / candleRange) >= bigCandleRatio
bearBigCandle = validRange and bearCandle and (candleBody / candleRange) >= bigCandleRatio

// 3. Engulfing
bullEngulf = validBody and bullCandle and not bullCandle[1]
             and (candleBody / prevBody) >= engulfRatio
             and close >= open[1] and open <= close[1]

bearEngulf = validBody and bearCandle and not bearCandle[1]
             and (candleBody / prevBody) >= engulfRatio
             and close <= open[1] and open >= close[1]

bullPattern = bullPinBar or bullBigCandle or bullEngulf
bearPattern = bearPinBar or bearBigCandle or bearEngulf

// ═══════════════════════════════════════════════════════════════════
//  ENTRY CONDITIONS
// ═══════════════════════════════════════════════════════════════════
noPosition     = strategy.position_size == 0
longCondition  = bullMomentum and htfBull and bullPattern and noPosition
shortCondition = bearMomentum and htfBear and bearPattern and noPosition

// ═══════════════════════════════════════════════════════════════════
//  SL / TP BOX MANAGEMENT
// ═══════════════════════════════════════════════════════════════════
var box slBox = na
var box tpBox = na
var line entryLine = na

deleteZone() =>
    box.delete(slBox)
    box.delete(tpBox)
    line.delete(entryLine)

drawZone(entryPrice, slPrice, tpPrice, isLong) =>
    deleteZone()
    slCol  = color.new(color.red,   75)
    tpCol  = color.new(color.green, 75)
    // SL box: entry → stop
    slBox    := box.new(bar_index, entryPrice, bar_index + 1, slPrice,
                        extend        = extend.right,
                        border_color  = color.new(color.red, 20),
                        border_width  = 1,
                        bgcolor       = slCol)
    // TP box: entry → target
    tpBox    := box.new(bar_index, entryPrice, bar_index + 1, tpPrice,
                        extend        = extend.right,
                        border_color  = color.new(color.green, 20),
                        border_width  = 1,
                        bgcolor       = tpCol)
    // Entry line
    entryLine := line.new(bar_index, entryPrice, bar_index + 1, entryPrice,
                          extend     = extend.right,
                          color      = color.new(color.white, 30),
                          width      = 1,
                          style      = line.style_dashed)

// Close zone when position is exited
positionClosed = strategy.position_size == 0 and strategy.position_size[1] != 0
if positionClosed
    deleteZone()

// ═══════════════════════════════════════════════════════════════════
//  TRADE EXECUTION
// ═══════════════════════════════════════════════════════════════════
if longCondition
    slDist  = (close - low)  * (1.0 + slBuffer / 100.0)
    slPrice = close - slDist
    tpPrice = close + slDist * rrRatio
    if showBoxes
        drawZone(close, slPrice, tpPrice, true)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", from_entry="Long", stop=slPrice, limit=tpPrice)

if shortCondition
    slDist  = (high - close) * (1.0 + slBuffer / 100.0)
    slPrice = close + slDist
    tpPrice = close - slDist * rrRatio
    if showBoxes
        drawZone(close, slPrice, tpPrice, false)
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", from_entry="Short", stop=slPrice, limit=tpPrice)

// ═══════════════════════════════════════════════════════════════════
//  VISUALS
// ═══════════════════════════════════════════════════════════════════

// EMA lines
plot(emaFast, "EMA 7",  color=color.new(color.aqua,   0), linewidth=2)
plot(emaSlow, "EMA 17", color=color.new(color.orange, 0), linewidth=2)

// HTF cloud
p1 = plot(showHTFCloud ? htfEmaFast : na, "HTF EMA 7",
          color=color.new(color.blue, 55), linewidth=1)
p2 = plot(showHTFCloud ? htfEmaSlow : na, "HTF EMA 17",
          color=color.new(color.red,  55), linewidth=1)
fill(p1, p2,
     color = htfBull ? color.new(color.green, 88) : color.new(color.red, 88),
     title = "HTF Cloud")

// Momentum background (only when EMAs slope strongly)
bgcolor(showBg and hasMomentum
        ? (bullMomentum ? color.new(color.green, 93) : color.new(color.red, 93))
        : na,
        title="Momentum BG")

// Signal arrows
plotshape(longCondition,  "Long",  shape.triangleup,
          location.belowbar, color=color.new(color.lime, 0), size=size.normal)
plotshape(shortCondition, "Short", shape.triangledown,
          location.abovebar, color=color.new(color.red,  0), size=size.normal)

// Pattern labels
patternLabel(cond, txt, yLoc, col) =>
    if cond
        label.new(bar_index, yLoc, txt,
                  style=label.style_label_center,
                  color=color.new(col, 65),
                  textcolor=color.white,
                  size=size.tiny)

patternLabel(longCondition  and bullPinBar,    "PIN", low  - candleRange * 0.6, color.green)
patternLabel(longCondition  and bullBigCandle, "MOM", low  - candleRange * 0.6, color.teal)
patternLabel(longCondition  and bullEngulf,    "ENG", low  - candleRange * 0.6, color.blue)
patternLabel(shortCondition and bearPinBar,    "PIN", high + candleRange * 0.6, color.red)
patternLabel(shortCondition and bearBigCandle, "MOM", high + candleRange * 0.6, color.maroon)
patternLabel(shortCondition and bearEngulf,    "ENG", high + candleRange * 0.6, color.purple)

// ═══════════════════════════════════════════════════════════════════
//  INFO TABLE
// ═══════════════════════════════════════════════════════════════════
var table infoTable = table.new(position.top_right, 2, 6,
     bgcolor=color.new(color.black, 55), border_color=color.gray, border_width=1)

if barstate.islast
    trendTxt = bullTrend   ? "▲ BULL"      : "▼ BEAR"
    trendCol = bullTrend   ? color.lime     : color.red
    htfTxt   = htfBull     ? "▲ BULL"      : "▼ BEAR"
    htfCol   = htfBull     ? color.lime     : color.red
    momTxt   = hasMomentum ? "✔ ACTIVE"    : "✘ FLAT"
    momCol   = hasMomentum ? color.lime     : color.gray
    aligned  = bullTrend == htfBull
    algnTxt  = aligned     ? "✔ ALIGNED"   : "✘ DIVERGING"
    algnCol  = aligned     ? color.lime     : color.orange

    table.cell(infoTable, 0, 0, "EMA Scalping 7/17",
               text_color=color.white, bgcolor=color.new(color.navy, 35), text_size=size.small)
    table.cell(infoTable, 1, 0, "", bgcolor=color.new(color.navy, 35))

    table.cell(infoTable, 0, 1, "Trend (LTF)", text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 1, trendTxt,      text_color=trendCol,     text_size=size.tiny)

    table.cell(infoTable, 0, 2, "HTF Trend",   text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 2, htfTxt,        text_color=htfCol,       text_size=size.tiny)

    table.cell(infoTable, 0, 3, "Momentum",    text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 3, momTxt,        text_color=momCol,       text_size=size.tiny)

    table.cell(infoTable, 0, 4, "Alignment",   text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 4, algnTxt,       text_color=algnCol,      text_size=size.tiny)

    table.cell(infoTable, 0, 5, "RR Ratio",    text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 5, "1:" + str.tostring(rrRatio),
               text_color=color.yellow, text_size=size.tiny)
