//@version=6
indicator(
    title      = "BTC CVD Flow — 15m Intraday",
    shorttitle = "CVD Flow 15m",
    overlay    = true
)

// ═══════════════════════════════════════════════════════════════════
//  KONZEPT
//
//  Entry-Trigger: VWAP-Pullback + Order Flow Bestätigung (CVD)
//    → Preis zieht zum VWAP zurück (Fair Value) von oben = Long
//    → Preis zieht zum VWAP zurück (Fair Value) von unten = Short
//
//  Warum CVD + Pullback statt Crossover?
//    Ein VWAP-Kreuzungspunkt ist ein Umkehrsignal — dort dreht der
//    Trend gerade erst. Der stärkste Entry entsteht beim ersten
//    Rückzug zum VWAP nach einer Trendbewegung (institutionelles
//    Re-Test-Muster). CVD zeigt, ob Kaufdruck/Verkaufsdruck
//    weiterhin aktiv ist, ohne Tick-Daten zu benötigen.
//
//  Confluence (nicht-widersprechend):
//    CVD       → Order Flow Richtung bestätigt
//    EMA 21/55 → Trendrichtung auf 15m
//    1h EMA    → Übergeordneter Stunden-Bias
//    RSI       → Extreme ausschließen (kein OB-Long, kein OS-Short)
//    Session   → London (07-11) oder NY (13-17) UTC
//
//  Take-Profit: VWAP ±1σ Band
//  Stop-Loss:   ATR × 1.2 unter/über Entry
// ═══════════════════════════════════════════════════════════════════

// ─── INPUTS ──────────────────────────────────────────────────────────────────

grpCvd = "Order Flow (CVD)"
cvdLen      = input.int(50, "CVD Fenster (Bars)",     minval=10, group=grpCvd,
              tooltip="Rollierendes Fenster für den CVD. Größer = träger, aber stabiler.")
cvdLookback = input.int(5,  "CVD Trend-Lookback",     minval=1,  group=grpCvd,
              tooltip="CVD muss seit X Bars in Signalrichtung laufen.")

grpVwap = "VWAP"
vwapStdLen    = input.int(20,    "Std.-Abweichung Länge",      minval=5,   group=grpVwap)
vwapProximity = input.float(0.50,"Pullback-Zone (% zum VWAP)", minval=0.05, maxval=2.0, step=0.05, group=grpVwap,
               tooltip="Preis muss innerhalb dieser % Distanz zum VWAP liegen.")

grpEma = "EMA Trend-Filter"
emaFastLen = input.int(21, "Fast EMA", minval=1, group=grpEma,
             tooltip="EMA21 auf 15m ≈ 5h Geschichte.")
emaSlowLen = input.int(55, "Slow EMA", minval=1, group=grpEma,
             tooltip="EMA55 auf 15m ≈ 14h Geschichte.")

grpRsi = "RSI"
rsiLen = input.int(14,    "RSI Länge",                         minval=1, group=grpRsi)
rsiOB  = input.float(75,  "Überkauft — Long ausschließen",     minval=60, maxval=90, step=1, group=grpRsi)
rsiOS  = input.float(25,  "Überverkauft — Short ausschließen", minval=10, maxval=40, step=1, group=grpRsi)

grpHTF = "1h Bias-Filter"
htfRes = input.timeframe("60", "HTF Timeframe", group=grpHTF)
useHtf = input.bool(true, "1h Filter aktiv", group=grpHTF)

grpRisk = "SL / TP"
atrLen    = input.int(14,    "ATR Länge",         minval=1,   group=grpRisk)
atrSlMult = input.float(1.2, "Stop-Loss = ATR ×", minval=0.5, step=0.1, group=grpRisk,
            tooltip="Engerer SL als früher — VWAP als klar definiertes Level.")

grpSession = "Session (UTC)"
useLondon = input.bool(true, "London  07–11 UTC", group=grpSession)
useNY     = input.bool(true, "New York 13–17 UTC", group=grpSession)

grpVis = "Visuals"
showBands    = input.bool(true, "VWAP-Bänder anzeigen (±1σ, ±2σ)", group=grpVis)
showBoxes    = input.bool(true, "SL / TP Boxen anzeigen",           group=grpVis)
showBg       = input.bool(true, "Session/Trend-Hintergrund",         group=grpVis)
showHTFCloud = input.bool(true, "1h EMA Cloud anzeigen",             group=grpVis)
showCvdBars  = input.bool(true, "CVD Bar-Farbe anzeigen",            group=grpVis)
showZone     = input.bool(true, "Pullback-Zone hervorheben",         group=grpVis)

// ─── CVD (APPROXIMATION) ─────────────────────────────────────────────────────
// Positives Volumen bei bullischem Bar, negatives bei bearischem
deltaVol = volume * (close >= open ? 1.0 : -1.0)
cvd      = math.sum(deltaVol, cvdLen)
cvdSlope = cvd - cvd[cvdLookback]
cvdBull  = cvdSlope > 0
cvdBear  = cvdSlope < 0

// ─── VWAP + BÄNDER ───────────────────────────────────────────────────────────
vwapValue = ta.vwap(hlc3)
vwapStdev = ta.stdev(hlc3, vwapStdLen)

vwapUpper1 = vwapValue + 1.0 * vwapStdev
vwapLower1 = vwapValue - 1.0 * vwapStdev
vwapUpper2 = vwapValue + 2.0 * vwapStdev
vwapLower2 = vwapValue - 2.0 * vwapStdev

// Pullback-Zone: Preis nähert sich VWAP als Fair Value
proxFactor   = vwapProximity / 100.0
nearVwapBull = close > vwapValue and close < vwapValue * (1.0 + proxFactor)
nearVwapBear = close < vwapValue and close > vwapValue * (1.0 - proxFactor)

// VWAP-Kreuzung als zusätzlicher Short-Trigger (fängt schnelle Breakdowns)
vwapBearCross = ta.crossunder(close, vwapValue)

// ─── EMA TREND-FILTER ────────────────────────────────────────────────────────
emaFast   = ta.ema(close, emaFastLen)
emaSlow   = ta.ema(close, emaSlowLen)
bullTrend = emaFast > emaSlow
bearTrend = emaFast < emaSlow

// ─── RSI ─────────────────────────────────────────────────────────────────────
rsiVal    = ta.rsi(close, rsiLen)
rsiBullOk = rsiVal < rsiOB
rsiBearOk = rsiVal > rsiOS

// ─── ATR ─────────────────────────────────────────────────────────────────────
atr14 = ta.atr(atrLen)

// ─── HTF 1h ──────────────────────────────────────────────────────────────────
htfEmaFast = request.security(syminfo.tickerid, htfRes,
              ta.ema(close, emaFastLen), lookahead=barmerge.lookahead_off)
htfEmaSlow = request.security(syminfo.tickerid, htfRes,
              ta.ema(close, emaSlowLen), lookahead=barmerge.lookahead_off)
htfBull = useHtf ? htfEmaFast > htfEmaSlow : true
htfBear = useHtf ? htfEmaFast < htfEmaSlow : true

// ─── SESSION ─────────────────────────────────────────────────────────────────
londonOpen = hour >= 7  and hour < 11
nyOpen     = hour >= 13 and hour < 17
inSession  = (useLondon and londonOpen) or (useNY and nyOpen)

// ─── SIGNAL-BEDINGUNGEN ──────────────────────────────────────────────────────
// Long: Pullback zum VWAP von oben + CVD bestätigt Käufer + Trend + Session
longCondition  = nearVwapBull
                 and cvdBull
                 and bullTrend
                 and htfBull
                 and rsiBullOk
                 and inSession

// Short: Pullback zum VWAP von unten ODER direkter Breakdown durch VWAP
// + CVD bestätigt Verkäufer + Trend + Session
shortCondition = (nearVwapBear or vwapBearCross)
                 and cvdBear
                 and bearTrend
                 and htfBear
                 and rsiBearOk
                 and inSession

// ─── BOX-STATE ───────────────────────────────────────────────────────────────
var box   slBox     = na
var box   tpBox     = na
var line  entryLine = na
var float sigSL     = na
var float sigTP     = na
var bool  inLong    = false
var bool  inShort   = false

if inLong and not na(sigSL)
    if low <= sigSL or high >= sigTP
        box.delete(slBox)
        box.delete(tpBox)
        line.delete(entryLine)
        inLong := false
        sigSL  := na
        sigTP  := na

if inShort and not na(sigSL)
    if high >= sigSL or low <= sigTP
        box.delete(slBox)
        box.delete(tpBox)
        line.delete(entryLine)
        inShort := false
        sigSL   := na
        sigTP   := na

// ─── SIGNALE + BOXEN ─────────────────────────────────────────────────────────
if longCondition and not inLong
    sigSL  := close - atr14 * atrSlMult
    sigTP  := vwapUpper1
    inLong  := true
    inShort := false
    if showBoxes
        box.delete(slBox)
        box.delete(tpBox)
        line.delete(entryLine)
        slBox     := box.new(bar_index, close, bar_index + 1, sigSL,
                             extend=extend.right,
                             border_color=color.new(color.red,   15), border_width=1,
                             bgcolor     =color.new(color.red,   82))
        tpBox     := box.new(bar_index, close, bar_index + 1, sigTP,
                             extend=extend.right,
                             border_color=color.new(color.green, 15), border_width=1,
                             bgcolor     =color.new(color.green, 82))
        entryLine := line.new(bar_index, close, bar_index + 1, close,
                              extend=extend.right,
                              color=color.new(color.white, 25), width=1,
                              style=line.style_dashed)

if shortCondition and not inShort
    sigSL  := close + atr14 * atrSlMult
    sigTP  := vwapLower1
    inShort := true
    inLong  := false
    if showBoxes
        box.delete(slBox)
        box.delete(tpBox)
        line.delete(entryLine)
        slBox     := box.new(bar_index, close, bar_index + 1, sigSL,
                             extend=extend.right,
                             border_color=color.new(color.red,   15), border_width=1,
                             bgcolor     =color.new(color.red,   82))
        tpBox     := box.new(bar_index, close, bar_index + 1, sigTP,
                             extend=extend.right,
                             border_color=color.new(color.green, 15), border_width=1,
                             bgcolor     =color.new(color.green, 82))
        entryLine := line.new(bar_index, close, bar_index + 1, close,
                              extend=extend.right,
                              color=color.new(color.white, 25), width=1,
                              style=line.style_dashed)

// ─── VISUALS ─────────────────────────────────────────────────────────────────

// CVD Bar-Farbe (grün = Kaufdruck, rot = Verkaufsdruck)
barcolor(showCvdBars
         ? (cvdBull ? color.new(color.lime, 55) : color.new(color.red, 55))
         : na,
         title="CVD Bar Color")

// VWAP-Linie
plot(vwapValue, "VWAP", color=color.new(color.yellow, 0), linewidth=2,
     style=plot.style_stepline)

// Pullback-Zone (Highlight wenn Preis in der Zone)
p_bullH = plot(showZone and nearVwapBull ? vwapValue * (1.0 + proxFactor) : na,
               display=display.none, editable=false)
p_bullL = plot(showZone and nearVwapBull ? vwapValue                      : na,
               display=display.none, editable=false)
p_bearH = plot(showZone and nearVwapBear ? vwapValue                      : na,
               display=display.none, editable=false)
p_bearL = plot(showZone and nearVwapBear ? vwapValue * (1.0 - proxFactor) : na,
               display=display.none, editable=false)
fill(p_bullH, p_bullL, color=color.new(color.lime, 80), title="Bull Pullback Zone")
fill(p_bearH, p_bearL, color=color.new(color.red,  80), title="Bear Pullback Zone")

// VWAP-Bänder ±1σ und ±2σ
plot(showBands ? vwapUpper1 : na, "VWAP +1σ",
     color=color.new(color.green, 40), linewidth=1)
plot(showBands ? vwapLower1 : na, "VWAP -1σ",
     color=color.new(color.red,   40), linewidth=1)
plot(showBands ? vwapUpper2 : na, "VWAP +2σ",
     color=color.new(color.green, 65), linewidth=1)
plot(showBands ? vwapLower2 : na, "VWAP -2σ",
     color=color.new(color.red,   65), linewidth=1)

// EMA-Linien
plot(emaFast, "EMA 21", color=color.new(color.aqua,   0), linewidth=2)
plot(emaSlow, "EMA 55", color=color.new(color.orange, 0), linewidth=2)

// 1h Cloud
p1 = plot(showHTFCloud ? htfEmaFast : na, "1h EMA 21",
          color=color.new(color.blue, 55), linewidth=1)
p2 = plot(showHTFCloud ? htfEmaSlow : na, "1h EMA 55",
          color=color.new(color.red,  55), linewidth=1)
fill(p1, p2,
     color = htfBull ? color.new(color.green, 88) : color.new(color.red, 88),
     title = "1h Cloud")

// Session/Trend-Hintergrund
bgcolor(showBg
        ? (not inSession
           ? color.new(color.gray,  97)
           : bullTrend
             ? color.new(color.green, 94)
             : bearTrend
               ? color.new(color.red, 94)
               : na)
        : na,
        title="Session/Trend BG")

// Signal-Pfeile
plotshape(longCondition,  "LONG",  shape.triangleup,
          location.belowbar, color=color.new(color.lime, 0), size=size.normal)
plotshape(shortCondition, "SHORT", shape.triangledown,
          location.abovebar, color=color.new(color.red,  0), size=size.normal)

// ─── ALERTS ──────────────────────────────────────────────────────────────────
if longCondition and not inLong
    alert("LONG ▲  " + syminfo.ticker + " 15m" +
          "  |  VWAP-Pullback + CVD Bull" +
          "  |  RSI: " + str.tostring(math.round(rsiVal, 1)) +
          "  |  SL: "  + str.tostring(math.round(close - atr14 * atrSlMult, 2)) +
          "  |  TP: "  + str.tostring(math.round(vwapUpper1, 2)) + " (VWAP +1σ)",
          alert.freq_once_per_bar_close)

if shortCondition and not inShort
    alert("SHORT ▼  " + syminfo.ticker + " 15m" +
          "  |  VWAP-Pullback + CVD Bear" +
          "  |  RSI: " + str.tostring(math.round(rsiVal, 1)) +
          "  |  SL: "  + str.tostring(math.round(close + atr14 * atrSlMult, 2)) +
          "  |  TP: "  + str.tostring(math.round(vwapLower1, 2)) + " (VWAP -1σ)",
          alert.freq_once_per_bar_close)

alertcondition(longCondition,  "Long Signal  ▲", "LONG — CVD Flow 15m BTC")
alertcondition(shortCondition, "Short Signal ▼", "SHORT — CVD Flow 15m BTC")
alertcondition(longCondition or shortCondition, "Beliebiges Signal", "Signal — CVD Flow 15m BTC")

// ─── INFO-TABELLE ─────────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 10,
     bgcolor=color.new(color.black, 20),
     border_color=color.new(color.gray, 30), border_width=1)

cvdTxt = (cvdBull ? "▲ " : "▼ ") + str.tostring(math.round(cvd / 1000, 1)) + "k"
cvdCol = cvdBull ? color.lime : color.red

vwapPosTxt = nearVwapBull ? "Pullback-Zone BULL"
             : nearVwapBear ? "Pullback-Zone BEAR"
             : vwapBearCross ? "VWAP-Breakdown"
             : close > vwapValue ? "über VWAP"
             : "unter VWAP"
vwapPosCol = close > vwapValue ? color.lime : color.red

trendTxt = bullTrend ? "▲ BULL EMA21>55" : "▼ BEAR EMA21<55"
trendCol = bullTrend ? color.lime : color.red

htfTxt = htfBull ? "▲ BULL (1h)" : "▼ BEAR (1h)"
htfCol = htfBull ? color.lime    : color.red

rsiTxt = str.tostring(math.round(rsiVal, 1))
rsiCol = rsiVal >= rsiOB ? color.red : rsiVal <= rsiOS ? color.orange : color.lime

sessTxt = londonOpen ? "✔ London 07-11" : nyOpen ? "✔ New York 13-17" : "✘ außerhalb"
sessCol = inSession  ? color.lime : color.gray

sigTxt = longCondition ? "▲ LONG" : shortCondition ? "▼ SHORT" : "— kein Signal"
sigCol = longCondition ? color.lime : shortCondition ? color.red : color.silver

table.cell(t, 0, 0, "CVD Flow 15m",
           text_color=color.white, bgcolor=color.new(color.navy, 10), text_size=size.small)
table.cell(t, 1, 0, "",            bgcolor=color.new(color.navy, 10))

table.cell(t, 0, 1, "Order Flow CVD", text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 1, cvdTxt,           text_color=cvdCol,       text_size=size.tiny)
table.cell(t, 0, 2, "VWAP Position",  text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 2, vwapPosTxt,       text_color=vwapPosCol,   text_size=size.tiny)
table.cell(t, 0, 3, "EMA Trend",      text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 3, trendTxt,         text_color=trendCol,     text_size=size.tiny)
table.cell(t, 0, 4, "1h Bias",        text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 4, htfTxt,           text_color=htfCol,       text_size=size.tiny)
table.cell(t, 0, 5, "RSI",            text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 5, rsiTxt,           text_color=rsiCol,       text_size=size.tiny)
table.cell(t, 0, 6, "Session",        text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 6, sessTxt,          text_color=sessCol,      text_size=size.tiny)
table.cell(t, 0, 7, "Signal",         text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 7, sigTxt,           text_color=sigCol,       text_size=size.tiny)
table.cell(t, 0, 8, "SL",             text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 8, str.tostring(atrSlMult) + " × ATR",
           text_color=color.yellow, text_size=size.tiny)
table.cell(t, 0, 9, "TP",             text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 9, "VWAP +1σ / -1σ",
           text_color=color.yellow, text_size=size.tiny)
