//@version=6
indicator(
     title     = "BTC Intraday Signals — VWAP + EMA 21/55",
     shorttitle = "VWAP Intraday",
     overlay    = true
 )

// ═══════════════════════════════════════════════════════════════════
//  KONZEPT
//
//  Entry-Trigger: VWAP-Kreuzung mit Volumen
//    → Preis kreuzt VWAP von unten nach oben + Volumen-Spike = Long
//    → Preis kreuzt VWAP von oben nach unten + Volumen-Spike = Short
//    Der erste Test des VWAPs nach einer Trendbewegung ist der stärkste.
//
//  Warum VWAP als Trigger?
//    VWAP ist der faire Tagespreis gewichtet nach Volumen.
//    Wenn der Preis mit starkem Volumen über den VWAP bricht,
//    dreht sich der Tages-Bias — das ist ein messbares, wiederholbares
//    institutionelles Muster.
//
//  Pflicht-Confluence (alle müssen grün sein):
//    EMA 21/55  → Trendrichtung bestätigt (kein Gegentrend-Entry)
//    ADX ≥ 20   → Echter Trend, kein Seitwärts
//    Volume     → Volumen-Spike am Kreuzungs-Bar (kein Fake)
//    RSI        → Im Trending-Bereich
//    4h EMA     → Übergeordneter Tages-Bias stimmt überein
//
//  Take-Profit: VWAP ± 1σ Band (natürliche Zielzone)
//  Stop-Loss:   ATR × 1.5 unter/über dem Entry
// ═══════════════════════════════════════════════════════════════════

// ─── INPUTS ──────────────────────────────────────────────────────────────────

grpVwap = "VWAP"
vwapStdLen  = input.int(20,   "Std.-Abweichung Länge",      minval=5,  group=grpVwap,
              tooltip="Periode für die Berechnung der VWAP-Bänder (±1σ, ±2σ).")
vwapVolMult = input.float(1.5,"Volumen-Spike am Cross (×Ø)", minval=1.0, step=0.1, group=grpVwap,
              tooltip="VWAP-Kreuzungs-Bar muss dieses Vielfache des 20-Bar-Volumens haben.")

grpEma = "EMA Trend-Filter"
emaFastLen = input.int(21, "Fast EMA", minval=1, group=grpEma,
             tooltip="EMA21 auf 15m ≈ 5h Geschichte. Muss in Signal-Richtung zeigen.")
emaSlowLen = input.int(55, "Slow EMA", minval=1, group=grpEma,
             tooltip="EMA55 auf 15m ≈ 14h Geschichte.")
slopeThresh = input.float(0.0002, "Min EMA21 Slope (×Preis)", minval=0, step=0.00005, group=grpEma,
              tooltip="EMA21 muss in Signalrichtung steigen/fallen — kein flacher Trend.")

grpMom = "Trendstärke"
adxLen    = input.int(14,   "ADX Länge", minval=1, group=grpMom)
adxThresh = input.float(20, "Min ADX",  minval=0, step=1,  group=grpMom,
            tooltip="Unter 20 = Seitwärtsmarkt → kein Signal.")

grpRsi = "RSI"
rsiLen     = input.int(14,   "RSI Länge",       minval=1, group=grpRsi)
rsiBullMin = input.float(45, "Long  – RSI min.", minval=20, maxval=60, step=1, group=grpRsi)
rsiBullMax = input.float(72, "Long  – RSI max.", minval=60, maxval=90, step=1, group=grpRsi)
rsiBearMin = input.float(28, "Short – RSI min.", minval=10, maxval=40, step=1, group=grpRsi)
rsiBearMax = input.float(55, "Short – RSI max.", minval=40, maxval=80, step=1, group=grpRsi)

grpHTF = "4h Bias-Filter"
htfRes = input.timeframe("240", "HTF Timeframe", group=grpHTF)
useHtf = input.bool(true, "4h Filter aktiv", group=grpHTF)

grpRisk = "SL / TP"
atrLen    = input.int(14,   "ATR Länge",        minval=1,   group=grpRisk)
atrSlMult = input.float(1.5, "Stop-Loss = ATR ×",minval=0.5, step=0.1, group=grpRisk,
            tooltip="SL enger als bei reinem EMA-Ansatz, weil VWAP-Level klar definiert.")

grpSession = "Session"
sessionStart  = input.int(7,  "Signale ab (UTC)",           minval=0, maxval=23, group=grpSession)
entryStopHour = input.int(19, "Kein neues Signal ab (UTC)", minval=0, maxval=23, group=grpSession)
eodHour       = input.int(21, "Tagesschluss-Hinweis (UTC)", minval=0, maxval=23, group=grpSession)

grpVis = "Visuals"
showBands    = input.bool(true,  "VWAP-Bänder anzeigen (±1σ, ±2σ)", group=grpVis)
showBoxes    = input.bool(true,  "SL / TP Boxen anzeigen",           group=grpVis)
showBg       = input.bool(true,  "Trend-Hintergrund anzeigen",        group=grpVis)
showHTFCloud = input.bool(true,  "4h EMA Cloud anzeigen",            group=grpVis)

// ─── VWAP + BÄNDER ───────────────────────────────────────────────────────────
vwapValue = ta.vwap(hlc3)
vwapStdev = ta.stdev(hlc3, vwapStdLen)

vwapUpper1 = vwapValue + 1.0 * vwapStdev
vwapLower1 = vwapValue - 1.0 * vwapStdev
vwapUpper2 = vwapValue + 2.0 * vwapStdev
vwapLower2 = vwapValue - 2.0 * vwapStdev

// VWAP-Kreuzung: Preis wechselt von einer Seite zur anderen
vwapBullCross = ta.crossover(close,  vwapValue)   // von unten nach oben
vwapBearCross = ta.crossunder(close, vwapValue)   // von oben nach unten

// ─── VOLUMEN ─────────────────────────────────────────────────────────────────
volAvg       = ta.sma(volume, 20)
volSpikeVwap = volume >= volAvg * vwapVolMult     // Volumen-Spike am VWAP-Cross

// ─── EMA TREND-FILTER ────────────────────────────────────────────────────────
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

bullTrend = emaFast > emaSlow
bearTrend = emaFast < emaSlow

slope1    = (emaFast - emaFast[1]) / close
slope2    = (emaFast[1] - emaFast[2]) / close[1]
bullSlope = slope1 >  slopeThresh and slope2 >  slopeThresh
bearSlope = slope1 < -slopeThresh and slope2 < -slopeThresh

// ─── ADX ─────────────────────────────────────────────────────────────────────
[_diPlus, _diMinus, adxVal] = ta.dmi(adxLen, adxLen)
trendStrong = adxVal >= adxThresh

// ─── RSI ─────────────────────────────────────────────────────────────────────
rsiVal    = ta.rsi(close, rsiLen)
rsiBullOk = rsiVal >= rsiBullMin and rsiVal <= rsiBullMax
rsiBearOk = rsiVal >= rsiBearMin and rsiVal <= rsiBearMax

// ─── ATR ─────────────────────────────────────────────────────────────────────
atr14 = ta.atr(atrLen)

// ─── HTF 4h ──────────────────────────────────────────────────────────────────
htfEmaFast = request.security(syminfo.tickerid, htfRes,
              ta.ema(close, emaFastLen), lookahead=barmerge.lookahead_off)
htfEmaSlow = request.security(syminfo.tickerid, htfRes,
              ta.ema(close, emaSlowLen), lookahead=barmerge.lookahead_off)
htfBull = useHtf ? htfEmaFast > htfEmaSlow : true
htfBear = useHtf ? htfEmaFast < htfEmaSlow : true

// ─── SESSION ─────────────────────────────────────────────────────────────────
inEntryWindow = hour >= sessionStart and hour < entryStopHour

// ─── SIGNAL-BEDINGUNGEN ──────────────────────────────────────────────────────
// Long: VWAP-Kreuzung nach oben + alle Confluence-Filter grün
longCondition  = vwapBullCross
                 and volSpikeVwap
                 and bullTrend and bullSlope
                 and trendStrong
                 and rsiBullOk
                 and htfBull
                 and inEntryWindow

// Short: VWAP-Kreuzung nach unten + alle Confluence-Filter grün
shortCondition = vwapBearCross
                 and volSpikeVwap
                 and bearTrend and bearSlope
                 and trendStrong
                 and rsiBearOk
                 and htfBear
                 and inEntryWindow

// ─── BOX-STATE ───────────────────────────────────────────────────────────────
var box   slBox     = na
var box   tpBox     = na
var line  entryLine = na
var line  tpLine1   = na
var float sigSL     = na
var float sigTP     = na
var bool  inLong    = false
var bool  inShort   = false

// Boxen schließen wenn SL oder TP getroffen
if inLong and not na(sigSL)
    if low <= sigSL or high >= sigTP
        box.delete(slBox)
        box.delete(tpBox)
        line.delete(entryLine)
        line.delete(tpLine1)
        inLong  := false
        sigSL   := na
        sigTP   := na

if inShort and not na(sigSL)
    if high >= sigSL or low <= sigTP
        box.delete(slBox)
        box.delete(tpBox)
        line.delete(entryLine)
        line.delete(tpLine1)
        inShort := false
        sigSL   := na
        sigTP   := na

// ─── SIGNALE + BOXEN ─────────────────────────────────────────────────────────
// TP = nächstes VWAP-Band (natürliche Zielzone)
if longCondition
    slDist  = atr14 * atrSlMult
    sigSL  := close - slDist
    sigTP  := vwapUpper1                     // TP = VWAP + 1σ
    inLong  := true
    inShort := false
    if showBoxes
        box.delete(slBox)
        box.delete(tpBox)
        line.delete(entryLine)
        line.delete(tpLine1)
        slBox     := box.new(bar_index, close, bar_index + 1, sigSL,
                             extend=extend.right,
                             border_color=color.new(color.red,   15), border_width=1,
                             bgcolor     =color.new(color.red,   82))
        tpBox     := box.new(bar_index, close, bar_index + 1, sigTP,
                             extend=extend.right,
                             border_color=color.new(color.green, 15), border_width=1,
                             bgcolor     =color.new(color.green, 82))
        entryLine := line.new(bar_index, close, bar_index + 1, close,
                              extend=extend.right,
                              color=color.new(color.white, 25), width=1,
                              style=line.style_dashed)

if shortCondition
    slDist  = atr14 * atrSlMult
    sigSL  := close + slDist
    sigTP  := vwapLower1                     // TP = VWAP - 1σ
    inShort := true
    inLong  := false
    if showBoxes
        box.delete(slBox)
        box.delete(tpBox)
        line.delete(entryLine)
        line.delete(tpLine1)
        slBox     := box.new(bar_index, close, bar_index + 1, sigSL,
                             extend=extend.right,
                             border_color=color.new(color.red,   15), border_width=1,
                             bgcolor     =color.new(color.red,   82))
        tpBox     := box.new(bar_index, close, bar_index + 1, sigTP,
                             extend=extend.right,
                             border_color=color.new(color.green, 15), border_width=1,
                             bgcolor     =color.new(color.green, 82))
        entryLine := line.new(bar_index, close, bar_index + 1, close,
                              extend=extend.right,
                              color=color.new(color.white, 25), width=1,
                              style=line.style_dashed)

// ─── VISUALS ─────────────────────────────────────────────────────────────────

// VWAP-Linie
plot(vwapValue, "VWAP", color=color.new(color.yellow, 0), linewidth=2,
     style=plot.style_stepline)

// VWAP-Bänder ±1σ und ±2σ
plot(showBands ? vwapUpper1 : na, "VWAP +1σ",
     color=color.new(color.green, 40), linewidth=1, style=plot.style_line)
plot(showBands ? vwapLower1 : na, "VWAP -1σ",
     color=color.new(color.red,   40), linewidth=1, style=plot.style_line)
plot(showBands ? vwapUpper2 : na, "VWAP +2σ",
     color=color.new(color.green, 65), linewidth=1, style=plot.style_line)
plot(showBands ? vwapLower2 : na, "VWAP -2σ",
     color=color.new(color.red,   65), linewidth=1, style=plot.style_line)

// EMA-Linien
plot(emaFast, "EMA 21", color=color.new(color.aqua,   0), linewidth=2)
plot(emaSlow, "EMA 55", color=color.new(color.orange, 0), linewidth=2)

// 4h Cloud
p1 = plot(showHTFCloud ? htfEmaFast : na, "4h EMA 21",
          color=color.new(color.blue, 55), linewidth=1)
p2 = plot(showHTFCloud ? htfEmaSlow : na, "4h EMA 55",
          color=color.new(color.red,  55), linewidth=1)
fill(p1, p2,
     color = htfBull ? color.new(color.green, 88) : color.new(color.red, 88),
     title = "4h Cloud")

// Trend-Hintergrund
bgcolor(showBg
        ? (not trendStrong
           ? color.new(color.gray,  96)
           : bullTrend and bullSlope
             ? color.new(color.green, 93)
             : bearTrend and bearSlope
               ? color.new(color.red,   93)
               : na)
        : na,
        title="Trend BG")

// Signal-Pfeile
plotshape(longCondition,  "LONG",  shape.triangleup,
          location.belowbar, color=color.new(color.lime, 0), size=size.normal)
plotshape(shortCondition, "SHORT", shape.triangledown,
          location.abovebar, color=color.new(color.red,  0), size=size.normal)

// ─── ALERTS ──────────────────────────────────────────────────────────────────
if longCondition
    alert("LONG ▲  " + syminfo.ticker + " 15m" +
          "  |  VWAP-Cross ↑ mit Volumen" +
          "  |  ADX: "   + str.tostring(math.round(adxVal,  1)) +
          "  |  RSI: "   + str.tostring(math.round(rsiVal,  1)) +
          "  |  SL: "    + str.tostring(math.round(close - atr14 * atrSlMult, 2)) +
          "  |  TP: "    + str.tostring(math.round(vwapUpper1, 2)) + " (VWAP +1σ)",
          alert.freq_once_per_bar_close)

if shortCondition
    alert("SHORT ▼  " + syminfo.ticker + " 15m" +
          "  |  VWAP-Cross ↓ mit Volumen" +
          "  |  ADX: "   + str.tostring(math.round(adxVal,  1)) +
          "  |  RSI: "   + str.tostring(math.round(rsiVal,  1)) +
          "  |  SL: "    + str.tostring(math.round(close + atr14 * atrSlMult, 2)) +
          "  |  TP: "    + str.tostring(math.round(vwapLower1, 2)) + " (VWAP -1σ)",
          alert.freq_once_per_bar_close)

alertcondition(longCondition,  "Long Signal  ▲", "LONG — VWAP Intraday BTC")
alertcondition(shortCondition, "Short Signal ▼", "SHORT — VWAP Intraday BTC")
alertcondition(longCondition or shortCondition, "Beliebiges Signal", "Signal — VWAP Intraday BTC")

// ─── INFO-TABELLE ─────────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 10,
     bgcolor=color.new(color.black, 20),
     border_color=color.new(color.gray, 30), border_width=1)

vwapPosTxt = close > vwapUpper1 ? "über +1σ"
             : close > vwapValue ? "über VWAP"
             : close > vwapLower1 ? "unter VWAP"
             : "unter -1σ"
vwapPosCol = close > vwapValue ? color.lime : color.red

trendTxt   = bullTrend and bullSlope ? "▲ BULL + Slope"
             : bearTrend and bearSlope ? "▼ BEAR + Slope"
             : bullTrend ? "▲ BULL (flach)" : "▼ BEAR (flach)"
trendCol   = (bullTrend and bullSlope) or (bearTrend and bearSlope) ? color.lime : color.orange

htfTxt     = htfBull     ? "▲ BULL (4h)"  : "▼ BEAR (4h)"
htfCol     = htfBull     ? color.lime      : color.red
adxTxt     = trendStrong ? "✔ " + str.tostring(math.round(adxVal, 1))
                         : "✘ " + str.tostring(math.round(adxVal, 1))
adxCol     = trendStrong ? color.lime : color.orange
rsiTxt     = str.tostring(math.round(rsiVal, 1))
rsiCol     = (rsiVal > rsiBullMax or rsiVal < rsiBearMin) ? color.red : color.lime
volRatio   = math.round(volume / volAvg, 2)
volTxt     = volSpikeVwap ? "✔ " + str.tostring(volRatio) + "× Ø"
                          : str.tostring(volRatio) + "× Ø"
volCol     = volSpikeVwap ? color.lime : color.gray
sessTxt    = inEntryWindow ? "✔ Entry-Fenster" : "✘ außerhalb"
sessCol    = inEntryWindow ? color.lime : color.gray
bandTxt    = "+1σ " + str.tostring(math.round(vwapUpper1, 1)) +
             "  |  -1σ " + str.tostring(math.round(vwapLower1, 1))

table.cell(t, 0, 0, "VWAP Intraday 21/55",
           text_color=color.white, bgcolor=color.new(color.navy, 10), text_size=size.small)
table.cell(t, 1, 0, "", bgcolor=color.new(color.navy, 10))

table.cell(t, 0, 1, "VWAP Position", text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 1, vwapPosTxt,      text_color=vwapPosCol,   text_size=size.tiny)
table.cell(t, 0, 2, "VWAP Bänder",   text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 2, bandTxt,         text_color=color.gray,   text_size=size.tiny)
table.cell(t, 0, 3, "EMA Trend",     text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 3, trendTxt,        text_color=trendCol,     text_size=size.tiny)
table.cell(t, 0, 4, "4h Bias",       text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 4, htfTxt,          text_color=htfCol,       text_size=size.tiny)
table.cell(t, 0, 5, "ADX",           text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 5, adxTxt,          text_color=adxCol,       text_size=size.tiny)
table.cell(t, 0, 6, "RSI",           text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 6, rsiTxt,          text_color=rsiCol,       text_size=size.tiny)
table.cell(t, 0, 7, "Volumen",       text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 7, volTxt,          text_color=volCol,       text_size=size.tiny)
table.cell(t, 0, 8, "Session",       text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 8, sessTxt,         text_color=sessCol,      text_size=size.tiny)
table.cell(t, 0, 9, "Schluss ~",     text_color=color.silver, text_size=size.tiny)
table.cell(t, 1, 9, str.tostring(eodHour) + ":00 UTC  |  SL ×" + str.tostring(atrSlMult),
           text_color=color.yellow, text_size=size.tiny)
